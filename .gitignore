# ---- 敏感文件：绝不提交 ----
# 环境变量（含 JWT_SECRET）
.env

# TLS 私钥与自签证书（部署时各自重新生成）
server.key
server.crt

# 企业恢复私钥（离线保管，绝不提交）
recovery_keys/
recovery_private.pem
recovery_public.pem

# 运行时数据：数据库 + 密文文件 + 测试账号数据
data/
*.bin
*.db
*.db-shm
*.db-wal

# ---- Python ----
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/

# ---- 编辑器 / IDE ----
.idea/
.vscode/
*.swp
.DS_Store

# ---- 临时 / 生成物 ----
.jbeval/
_*.png
